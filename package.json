{
  "name": "av-planner-suite",
  "private": true,
  "version": "1.0.0",
  "description": "LZ Planner Suite — Monorepo fuer cable-planner, multicam-planner und light-planner plus geteilte Pakete",
  "keywords": [
    "broadcast",
    "av-production",
    "live-production",
    "event-technology",
    "stage-lighting",
    "camera-planning",
    "cable-management",
    "production-planning",
    "monorepo",
    "electron",
    "react",
    "typescript",
    "threejs",
    "desktop-app",
    "cross-platform",
    "offline-first",
    "design-system",
    "ob-van"
  ],
  "author": {
    "name": "Lars Zumpe",
    "email": "lars@zumpe.dev"
  },
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace @avplan/inventory-core --workspace @avplan/onboarding-core --workspace @avplan/lexware-core --workspace @avplan/dmx-core --workspace @avplan/crew-core --workspace @avplan/device-catalog --workspace @avplan/floorplan --workspace @avplan/scene3d --workspace @avplan/ui",
    "build:planners": "npm run build --workspace cable-planner && npm run build --workspace multicam-planner && npm run build --workspace light-planner && npm run build --workspace inventory-planner && npm run build --workspace larszu-facility-planner && node apps/shell/scripts/copy-planners.mjs",
    "build": "npm run build:packages && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:cable": "npm run dev --workspace cable-planner",
    "dev:multicam": "npm run dev --workspace multicam-planner",
    "dev:light": "npm run dev --workspace light-planner",
    "spec:vocab": "node scripts/spec-source-vocabulary.mjs",
    "lang:parity": "node scripts/lang-parity.mjs",
    "stamp:parity": "node --experimental-strip-types --import ./scripts/register-ts-ext.mjs scripts/document-stamp-parity.ts",
    "drift": "node scripts/planner-drift.mjs --upstream ..",
    "drift:check": "node scripts/planner-drift.mjs --upstream .. --check",
    "drift-upstreams:check": "node scripts/drift-upstreams-check.mjs",
    "drift:report": "node scripts/planner-drift.mjs --upstream .. --report docs/research/repos/DRIFT-REPORT.md",
    "features:reachable": "node scripts/reachable-features.mjs",
    "dialogs:native": "node scripts/native-dialogs.mjs",
    "licence:check": "node scripts/licence-consistency.mjs",
    "katalog:erzeugen": "node scripts/katalog-erzeugen.mjs",
    "katalog:parity": "node scripts/katalog-erzeugen.mjs --pruefen",
    "docs:reachable": "node scripts/docs-reachable.mjs",
    "status:check": "node scripts/status-gegen-backlog.mjs",
    "backlog:check": "node scripts/backlog-status-frisch.mjs",
    "devports:check": "node scripts/dev-ports-match.mjs",
    "ci:complete": "node scripts/ci-runs-every-check.mjs",
    "deps:check": "node scripts/shell-deps-complete.mjs",
    "seed:check": "node scripts/seed-anschluss-check.mjs",
    "release:check": "node scripts/release-artefakte.mjs",
    "actions:check": "node scripts/actions-node-runtime.mjs",
    "ui:smoke": "node scripts/suite-smoke.mjs",
    "vertrag:parity": "node scripts/facility-vertrag-parity.mjs",
    "chrome:parity": "node scripts/chrome-parity.mjs",
    "bedienbar:check": "node scripts/bedienbar.mjs",
    "pakete:verteilen": "node scripts/pakete-verteilen.mjs --ziel ..",
    "pakete:pruefen": "node scripts/pakete-verteilen.mjs --ziel .. --pruefen"
  },
  "devDependencies": {
    "minimatch": "^10.2.5",
    "playwright-core": "^1.61.1"
  }
}
